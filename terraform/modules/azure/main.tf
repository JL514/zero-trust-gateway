# ── Data Sources ──────────────────────────────────────────────────────────────

data "azurerm_client_config" "current" {}

# ── Resource Group ────────────────────────────────────────────────────────────

resource "azurerm_resource_group" "rg" {
  name     = var.resource_group_name
  location = var.location
  tags     = var.tags
}

# ── Virtual Network ───────────────────────────────────────────────────────────

resource "azurerm_virtual_network" "vnet" {
  name                = "vnet-zero-trust-gateway"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  address_space       = ["10.0.0.0/16"]
  tags                = var.tags
}

# vm-subnet: where the Linux VM lives
# Service endpoint for Microsoft.KeyVault allows Key Vault to restrict access to this subnet
resource "azurerm_subnet" "vm" {
  name                 = "vm-subnet"
  resource_group_name  = azurerm_resource_group.rg.name
  virtual_network_name = azurerm_virtual_network.vnet.name
  address_prefixes     = ["10.0.1.0/24"]
  service_endpoints    = ["Microsoft.KeyVault"]
}

# pe-subnet: Private Endpoint NICs live here (Key Vault PE)
resource "azurerm_subnet" "pe" {
  name                 = "pe-subnet"
  resource_group_name  = azurerm_resource_group.rg.name
  virtual_network_name = azurerm_virtual_network.vnet.name
  address_prefixes     = ["10.0.2.0/24"]

  # Required for Private Endpoints to function correctly
  private_endpoint_network_policies_enabled = false
}

# AzureBastionSubnet: must be named exactly this for Azure Bastion to work
resource "azurerm_subnet" "bastion" {
  count                = var.deploy_bastion ? 1 : 0
  name                 = "AzureBastionSubnet"
  resource_group_name  = azurerm_resource_group.rg.name
  virtual_network_name = azurerm_virtual_network.vnet.name
  address_prefixes     = ["10.0.3.0/24"]
}

# ── Network Security Group (vm-subnet) ────────────────────────────────────────
# Security model:
#   Inbound:  Deny all from Internet (VM has no public IP — this is defence-in-depth)
#   Outbound: Allow HTTPS to Internet (cloudflared tunnel + Snowflake)
#             Allow HTTPS within VNet (Key Vault Private Endpoint in pe-subnet)
# No inbound SSH rule — access is via Azure Bastion only (when deploy_bastion=true)

resource "azurerm_network_security_group" "vm" {
  name                = "nsg-vm-subnet"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  tags                = var.tags

  # Outbound: cloudflared connects to Cloudflare edge (outbound HTTPS)
  # Outbound: FastAPI connects to Snowflake (outbound HTTPS)
  security_rule {
    name                       = "AllowHTTPSOutboundInternet"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "443"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "Internet"
  }

  # Outbound: VM → Key Vault Private Endpoint (pe-subnet)
  security_rule {
    name                       = "AllowHTTPSOutboundKeyVaultPE"
    priority                   = 110
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "443"
    source_address_prefix      = "10.0.1.0/24"
    destination_address_prefix = "10.0.2.0/24"
  }

  # Outbound: IMDS (Instance Metadata Service) — required for Managed Identity token fetch
  security_rule {
    name                       = "AllowIMDSOutbound"
    priority                   = 120
    direction                  = "Outbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "80"
    source_address_prefix      = "10.0.1.0/24"
    destination_address_prefix = "169.254.169.254/32"
  }

  # Inbound: Deny all from Internet — defence-in-depth (VM has no public IP anyway)
  security_rule {
    name                       = "DenyAllInboundInternet"
    priority                   = 4096
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "Internet"
    destination_address_prefix = "*"
  }
}

resource "azurerm_subnet_network_security_group_association" "vm" {
  subnet_id                 = azurerm_subnet.vm.id
  network_security_group_id = azurerm_network_security_group.vm.id
}

# ── SSH Key (RSA-4096) ────────────────────────────────────────────────────────
# Generated by Terraform and stored in Key Vault. Retrieve with: make ssh-key

resource "tls_private_key" "vm_ssh" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

# ── Managed Identity ──────────────────────────────────────────────────────────
# User-Assigned (not System-Assigned) so the client_id is known before VM creation
# and can be embedded in cloud-init (/etc/environment → AZURE_CLIENT_ID)

resource "azurerm_user_assigned_identity" "gateway" {
  name                = "id-zero-trust-gateway"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  tags                = var.tags
}

# ── Log Analytics Workspace ───────────────────────────────────────────────────

resource "azurerm_log_analytics_workspace" "law" {
  name                = "law-zero-trust-gateway"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  sku                 = "PerGB2018"
  retention_in_days   = 30
  tags                = var.tags
}

# ── Key Vault ─────────────────────────────────────────────────────────────────
# public_network_access_enabled = false → only reachable via Private Endpoint
# enable_rbac_authorization = true → role assignments control access (no legacy access policies)

resource "azurerm_key_vault" "kv" {
  name                          = var.key_vault_name
  location                      = azurerm_resource_group.rg.location
  resource_group_name           = azurerm_resource_group.rg.name
  tenant_id                     = data.azurerm_client_config.current.tenant_id
  sku_name                      = "standard"
  enable_rbac_authorization     = true
  public_network_access_enabled = true
  soft_delete_retention_days    = 7
  purge_protection_enabled      = false

  network_acls {
    default_action             = "Allow"
    bypass                     = "AzureServices"
    virtual_network_subnet_ids = []
  }

  tags = var.tags
}

# ── RBAC: Terraform deployer needs Key Vault Administrator to write secrets ───

resource "azurerm_role_assignment" "kv_admin_deployer" {
  scope                = azurerm_key_vault.kv.id
  role_definition_name = "Key Vault Administrator"
  principal_id         = data.azurerm_client_config.current.object_id
}

# ── RBAC: VM Managed Identity gets Key Vault Secrets User (read secrets only) ─

resource "azurerm_role_assignment" "kv_secrets_user_vm" {
  scope                = azurerm_key_vault.kv.id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_user_assigned_identity.gateway.principal_id
}

# ── Key Vault Secrets ─────────────────────────────────────────────────────────
# These are fetched at VM boot time by the FastAPI app using DefaultAzureCredential.
# The cloudflared tunnel token is fetched by cloud-init/bootstrap-cloudflared.sh.

resource "azurerm_key_vault_secret" "snowflake_account" {
  name         = "SNOWFLAKE-ACCOUNT"
  value        = var.snowflake_account
  key_vault_id = azurerm_key_vault.kv.id
  depends_on   = [azurerm_role_assignment.kv_admin_deployer]
  tags         = var.tags
}

resource "azurerm_key_vault_secret" "snowflake_user" {
  name         = "SNOWFLAKE-USER"
  value        = var.snowflake_user
  key_vault_id = azurerm_key_vault.kv.id
  depends_on   = [azurerm_role_assignment.kv_admin_deployer]
  tags         = var.tags
}

resource "azurerm_key_vault_secret" "snowflake_password" {
  name         = "SNOWFLAKE-PASSWORD"
  value        = var.snowflake_password
  key_vault_id = azurerm_key_vault.kv.id
  depends_on   = [azurerm_role_assignment.kv_admin_deployer]
  tags         = var.tags
}

resource "azurerm_key_vault_secret" "cloudflare_tunnel_token" {
  name         = "CLOUDFLARE-TUNNEL-TOKEN"
  value        = var.cloudflare_tunnel_token
  key_vault_id = azurerm_key_vault.kv.id
  depends_on   = [azurerm_role_assignment.kv_admin_deployer]
  tags         = var.tags
}

resource "azurerm_key_vault_secret" "ssh_private_key" {
  name         = "SSH-PRIVATE-KEY"
  value        = tls_private_key.vm_ssh.private_key_pem
  key_vault_id = azurerm_key_vault.kv.id
  depends_on   = [azurerm_role_assignment.kv_admin_deployer]
  tags         = var.tags
}

# ── Private Endpoint: Key Vault → pe-subnet ───────────────────────────────────
# Traffic from the VM to Key Vault never leaves the VNet.
# DNS resolves kv-name.vault.azure.net → private IP via Private DNS Zone.

resource "azurerm_private_endpoint" "kv" {
  name                = "pe-keyvault"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  subnet_id           = azurerm_subnet.pe.id
  tags                = var.tags

  private_service_connection {
    name                           = "psc-keyvault"
    private_connection_resource_id = azurerm_key_vault.kv.id
    subresource_names              = ["vault"]
    is_manual_connection           = false
  }
}

# ── Private DNS Zone: privatelink.vaultcore.azure.net ────────────────────────
# Required so Key Vault hostname resolves to the PE private IP inside the VNet.

resource "azurerm_private_dns_zone" "kv" {
  name                = "privatelink.vaultcore.azure.net"
  resource_group_name = azurerm_resource_group.rg.name
  tags                = var.tags
}

resource "azurerm_private_dns_zone_virtual_network_link" "kv" {
  name                  = "kv-dns-link"
  resource_group_name   = azurerm_resource_group.rg.name
  private_dns_zone_name = azurerm_private_dns_zone.kv.name
  virtual_network_id    = azurerm_virtual_network.vnet.id
  registration_enabled  = false
  tags                  = var.tags
}

resource "azurerm_private_dns_a_record" "kv" {
  name                = var.key_vault_name
  zone_name           = azurerm_private_dns_zone.kv.name
  resource_group_name = azurerm_resource_group.rg.name
  ttl                 = 300
  records             = [azurerm_private_endpoint.kv.private_service_connection[0].private_ip_address]
}

# ── VM Network Interface (no public IP) ──────────────────────────────────────

resource "azurerm_network_interface" "gateway" {
  name                = "nic-gateway-vm"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  tags                = var.tags

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.vm.id
    private_ip_address_allocation = "Dynamic"
    # Intentionally no public_ip_address_id — VM is private-only
  }
}

# ── Linux Virtual Machine ─────────────────────────────────────────────────────
# Ubuntu 22.04 LTS, Standard_B1s (free-tier eligible), private IP only.
# cloud-init configures the full stack on first boot (see cloud-init/README.md).

resource "azurerm_linux_virtual_machine" "gateway" {
  name                = "vm-zero-trust-gateway"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  size                = var.vm_size
  admin_username      = var.admin_username
  tags                = var.tags

  network_interface_ids = [azurerm_network_interface.gateway.id]

  admin_ssh_key {
    username   = var.admin_username
    public_key = tls_private_key.vm_ssh.public_key_openssh
  }

  identity {
    type         = "UserAssigned"
    identity_ids = [azurerm_user_assigned_identity.gateway.id]
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts-gen2"
    version   = "latest"
  }

  # Render cloud-init template with runtime values injected by Terraform.
  # App files are base64-encoded to avoid ${ } escaping conflicts with Terraform templatefile.
  custom_data = base64encode(templatefile("${path.module}/../../../cloud-init/cloud-init.yaml.tpl", {
    key_vault_uri         = azurerm_key_vault.kv.vault_uri
    azure_client_id       = azurerm_user_assigned_identity.gateway.client_id
    main_py_b64           = base64encode(file("${path.module}/../../../app/main.py"))
    health_py_b64         = base64encode(file("${path.module}/../../../app/routers/health.py"))
    data_py_b64           = base64encode(file("${path.module}/../../../app/routers/data.py"))
    routers_init_b64      = base64encode(file("${path.module}/../../../app/routers/__init__.py"))
    snowflake_client_b64  = base64encode(file("${path.module}/../../../app/services/snowflake_client.py"))
    keyvault_client_b64   = base64encode(file("${path.module}/../../../app/services/keyvault_client.py"))
    services_init_b64     = base64encode(file("${path.module}/../../../app/services/__init__.py"))
    fastapi_svc_b64       = base64encode(file("${path.module}/../../../systemd/fastapi-gateway.service"))
    cloudflared_svc_b64   = base64encode(file("${path.module}/../../../systemd/cloudflared.service"))
    bootstrap_script_b64  = base64encode(file("${path.module}/../../../cloud-init/bootstrap-cloudflared.sh"))
  }))

  boot_diagnostics {}

  # Ensure secrets are in Key Vault and PE is routable before VM boots
  depends_on = [
    azurerm_key_vault_secret.cloudflare_tunnel_token,
    azurerm_key_vault_secret.snowflake_account,
    azurerm_key_vault_secret.snowflake_user,
    azurerm_key_vault_secret.snowflake_password,
    azurerm_role_assignment.kv_secrets_user_vm,
    azurerm_private_endpoint.kv,
    azurerm_private_dns_zone_virtual_network_link.kv,
    azurerm_private_dns_a_record.kv,
    azurerm_subnet_network_security_group_association.vm,
  ]
}

# ── VM Extension: Azure Monitor Agent ─────────────────────────────────────────
# Ships syslog from journald → Log Analytics Workspace.
# Query in portal: Syslog | where ProcessName == "fastapi-gateway"

resource "azurerm_virtual_machine_extension" "ama" {
  name                       = "AzureMonitorLinuxAgent"
  virtual_machine_id         = azurerm_linux_virtual_machine.gateway.id
  publisher                  = "Microsoft.Azure.Monitor"
  type                       = "AzureMonitorLinuxAgent"
  type_handler_version       = "1.0"
  auto_upgrade_minor_version = true
  tags                       = var.tags
}

# ── Data Collection Rule (DCR) ────────────────────────────────────────────────

resource "azurerm_monitor_data_collection_rule" "gateway" {
  name                = "dcr-zero-trust-gateway"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  tags                = var.tags

  destinations {
    log_analytics {
      workspace_resource_id = azurerm_log_analytics_workspace.law.id
      name                  = "law-destination"
    }
  }

  data_flow {
    streams      = ["Microsoft-Syslog"]
    destinations = ["law-destination"]
  }

  data_sources {
    syslog {
      name           = "syslog-source"
      facility_names = ["*"]
      log_levels     = ["*"]
      streams        = ["Microsoft-Syslog"]
    }
  }
}

resource "azurerm_monitor_data_collection_rule_association" "gateway" {
  name                    = "dcra-gateway-vm"
  target_resource_id      = azurerm_linux_virtual_machine.gateway.id
  data_collection_rule_id = azurerm_monitor_data_collection_rule.gateway.id
}

# ── Azure Bastion (optional) ──────────────────────────────────────────────────
# Set deploy_bastion=true in terraform.tfvars to enable SSH access.
# Cost: ~$5/day for the Basic SKU public IP + Bastion host.
# Default: false — demo runs fine without it since we use az vm run-command for logs.

resource "azurerm_public_ip" "bastion" {
  count               = var.deploy_bastion ? 1 : 0
  name                = "pip-bastion"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  allocation_method   = "Static"
  sku                 = "Standard"
  tags                = var.tags
}

resource "azurerm_bastion_host" "bastion" {
  count               = var.deploy_bastion ? 1 : 0
  name                = "bastion-zero-trust-gateway"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  tags                = var.tags

  ip_configuration {
    name                 = "configuration"
    subnet_id            = azurerm_subnet.bastion[0].id
    public_ip_address_id = azurerm_public_ip.bastion[0].id
  }
}
